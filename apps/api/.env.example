# SnapBug API 环境变量示例（本地开发请通过 pnpm setup 自动生成 .env.development）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/snapbug?schema=public"
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="7d"

# AI 模型配置（OpenAI 兼容协议，支持 DeepSeek / 通义千问 / OpenAI 等）
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"

# 云对象存储配置（阿里云 OSS / 腾讯云 COS，客户端直传，不落盘应用服务器）
STORAGE_PROVIDER=""

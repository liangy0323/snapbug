{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@rsbuild/core/types", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@repo/charts": ["../../packages/charts/src/index.ts"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/shared/types": ["../../packages/shared/src/types/index.ts"],
      "@repo/shared/utils": ["../../packages/shared/src/utils/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "*.config.ts",
    "env.d.ts",
    "auto-imports.d.ts",
    "components.d.ts",
    "tests/**/*.ts",
    "build/**/*.ts"
  ]
}
